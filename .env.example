# Torq-Pamba environment.
# `npm run setup` copies this file to .env.local when that file is missing.
# Leave secrets empty to run entirely on the mock provider. Do not put real
# keys in this file. Stripe live keys (sk_live_) are refused by the app.

# Postgres connection string (node-postgres). When empty, the app uses embedded PGlite.
DATABASE_URL=

# PGlite data directory. Default in code is ./.data/pglite. "memory" is in-memory (unit tests).
PGLITE_DIR=

# mock (default) or live. Live vendor calls also require that vendor's key.
PROVIDER_MODE=mock

# Set to 1 to allow onboarding fetches of private/local IPs in production.
# Those fetches are already allowed when NODE_ENV is not production.
ALLOW_LOCAL_ONBOARDING=

# Google Gemini API (Omni Flash, Veo 3.1, Gemini chat). Used only when PROVIDER_MODE=live.
GEMINI_API_KEY=

# Anthropic API (Claude Sonnet 5 chat). Used only when PROVIDER_MODE=live.
# Live chat prefers this key, then XAI_API_KEY (Grok 4.7), then GEMINI_API_KEY.
ANTHROPIC_API_KEY=

# Claude model for the tool-calling chat agent. Empty means claude-opus-5-5. Needs PROVIDER_MODE=live and ANTHROPIC_API_KEY.
CHAT_AGENT_MODEL=

# Runway API (Seedance 2.0). Used only when PROVIDER_MODE=live.
RUNWAY_API_KEY=

# xAI API (grok-imagine video and image). Used only when PROVIDER_MODE=live.
XAI_API_KEY=

# Kling avatar. Used only when PROVIDER_MODE=live.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# HeyGen. Used only when PROVIDER_MODE=live.
HEYGEN_API_KEY=

# Stripe TEST mode only. A key starting with sk_live_ is refused.
# With no secret key, billing simulates a test-mode upgrade.
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# Required to accept POST /api/billing/webhook. When empty, the webhook returns 401.
STRIPE_WEBHOOK_SECRET=

# Required to accept POST /api/cron/tick (Authorization: Bearer <secret>). When empty, the tick returns 401.
CRON_SECRET=

# Set to 1 to let the cron tick and the webhook run without their secrets on a local machine.
# Ignored when NODE_ENV is production.
ALLOW_INSECURE_LOCAL_ENDPOINTS=
