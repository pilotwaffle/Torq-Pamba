# Torq-Pamba environment.
# `npm run setup` copies this file to .env.local when that file is missing.
# Leave secrets empty to run entirely on the mock provider. Do not put real
# keys in this file. Stripe live keys (sk_live_) are refused by the app.

# Postgres connection string (node-postgres). When empty, the app uses embedded PGlite.
DATABASE_URL=

# PGlite data directory. Default in code is ./.data/pglite. "memory" is in-memory (unit tests).
PGLITE_DIR=

# mock (default) or live. Live vendor calls also require that vendor's key.
PROVIDER_MODE=mock

# Set to 1 to allow onboarding fetches of private/local IPs in production.
# Those fetches are already allowed when NODE_ENV is not production.
ALLOW_LOCAL_ONBOARDING=

# Google Gemini API (Omni Flash, Veo 3.1, Gemini chat). Used only when PROVIDER_MODE=live.
GEMINI_API_KEY=

# Anthropic API (Claude Sonnet 5 chat). Used only when PROVIDER_MODE=live.
# Live chat prefers this key, then XAI_API_KEY (Grok 4.7), then GEMINI_API_KEY.
ANTHROPIC_API_KEY=

# Claude model for the tool-calling chat agent. Empty means claude-opus-5-5. Needs PROVIDER_MODE=live and ANTHROPIC_API_KEY.
CHAT_AGENT_MODEL=

# Runway API (Seedance 2.0). Used only when PROVIDER_MODE=live.
RUNWAY_API_KEY=

# xAI API (grok-imagine video and image). Used only when PROVIDER_MODE=live.
XAI_API_KEY=

# Kling avatar. Used only when PROVIDER_MODE=live.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Kling API key (the current auth scheme). Used instead of the access/secret pair when set.
KLING_API_KEY=

# HeyGen. Used only when PROVIDER_MODE=live.
HEYGEN_API_KEY=
# HeyGen voice for script-driven avatar videos when no voice track is supplied.
HEYGEN_VOICE_ID=

# ElevenLabs (text-to-speech, voice clones, voice previews). Used only when PROVIDER_MODE=live.
ELEVENLABS_API_KEY=

# Stripe TEST mode only. A key starting with sk_live_ is refused.
# With no secret key, billing is simulated: checkout and top-ups grant credits without payment.
STRIPE_SECRET_KEY=
# Recurring monthly test-mode Price ids for the Hobby ($16) and Pro ($100) credit plans.
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
# Required to accept POST /api/billing/webhook. When empty, the webhook returns 401.
STRIPE_WEBHOOK_SECRET=

# Required to accept POST /api/cron/tick (Authorization: Bearer <secret>). When empty, the tick returns 401.
CRON_SECRET=

# Set to 1 to let the cron tick and the webhook run without their secrets on a local machine.
# Ignored when NODE_ENV is production.
ALLOW_INSECURE_LOCAL_ENDPOINTS=

# Research sources, comma-separated in order of preference: youtube, scrapecreators, apify.
# Empty or "mock" uses sample data. Live sources also need PROVIDER_MODE=live and their key.
RESEARCH_SOURCE=
# YouTube Data API v3 key (official API, public data). Used only when PROVIDER_MODE=live.
YOUTUBE_API_KEY=
# ScrapeCreators API key (public TikTok and Instagram data). Used only when PROVIDER_MODE=live.
SCRAPECREATORS_API_KEY=
# Apify API token for the TikTok Scraper actor (public data). Used only when PROVIDER_MODE=live.
APIFY_TOKEN=

# Where generated clips and final MP4s are stored: local (default) or s3 (AWS S3 or Cloudflare R2).
MEDIA_STORAGE=
# Local media directory. Default ./.data/media.
MEDIA_LOCAL_DIR=
# S3-compatible bucket, used when MEDIA_STORAGE=s3.
MEDIA_S3_BUCKET=
# Region. Default us-east-1, or auto when MEDIA_S3_ENDPOINT is set (R2).
MEDIA_S3_REGION=
# Custom endpoint, e.g. https://<account>.r2.cloudflarestorage.com. Empty for AWS S3.
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# 1 for path-style URLs, 0 for virtual-hosted. Default: path-style when MEDIA_S3_ENDPOINT is set.
MEDIA_S3_FORCE_PATH_STYLE=
# Optional public base URL (CDN or R2 public bucket). Otherwise media is served through presigned URLs.
MEDIA_S3_PUBLIC_BASE_URL=

# ffmpeg and ffprobe binaries. Default: ffmpeg and ffprobe on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Font for burned-in captions. Default: a common system font, else fontconfig.
FFMPEG_FONT_FILE=

# How long Generate waits for the clip and render jobs before returning. Default 45000.
VIDEO_INLINE_WAIT_MS=
# How long one provider clip job may run before the fallback chain moves on. Default 1200000 (20 min).
VIDEO_JOB_TIMEOUT_MS=
# Pause between passes of `npm run worker`. Default 2000.
WORKER_INTERVAL_MS=
# --- Phase 2: publishing ---------------------------------------------------
# (Clip and render storage is MEDIA_STORAGE / MEDIA_LOCAL_DIR above; ffmpeg is FFMPEG_PATH above.)

# How long a publisher polls a platform's processing status before giving up, in ms. Default 600000.
PROVIDER_POLL_TIMEOUT_MS=
# Nano Banana image models (Gemini image). Ids are overridable because they change.
NANO_BANANA_2_MODEL=
NANO_BANANA_PRO_MODEL=

# Public https origin of this deployment. Needed for OAuth redirect URIs, for
# platforms to pull rendered videos from /api/media/<key>, and as the issuer and
# resource in the OAuth/MCP metadata (/.well-known/*). Falls back to the request host.
PUBLIC_BASE_URL=

# mock (default) or live. Live posting also needs that platform's app credentials.
PUBLISH_MODE=mock
# 32 bytes (64 hex chars or base64). Required in production to store OAuth tokens.
TOKEN_ENCRYPTION_KEY=
# HMAC secret for OAuth state. Required in production.
OAUTH_STATE_SECRET=

# TikTok Login Kit + Content Posting API app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set to 1 only after TikTok approves the Content Posting audit. Until then posts are
# forced private (SELF_ONLY) and at most 5 creators can post per 24 hours.
TIKTOK_AUDITED=

# Instagram API with Instagram Login (content publishing + insights).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Login for Pages (Page Reels + insights).
META_APP_ID=
META_APP_SECRET=
# Graph API version. Default v24.0.
META_GRAPH_VERSION=
